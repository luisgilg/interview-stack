{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Server": {
      "Port": 8083,
      "ReadTimeout": "00:00:05",
      "WriteTimeout": "00:00:05",
      "IdleTimeout": "00:02:00",
      "ShutdownTimeout": "00:00:05",
      "RequestTimeouts": {
        "Read": "00:00:02",
        "Write": "00:00:05",
        "Health": "00:00:02"
      }
    },
    "Database": {
      "Type": "sql",
      "Postgres": {
        "Host": "postgres",
        "Port": 5432,
        "User": "postgres",
        "Password": "postgres",
        "Db": "productsdb",
        "ConnectTimeout": "00:00:05"
      },
      "Mongo": {
        "Uri": "mongodb://mongo:27017",
        "Database": "productsdb",
        "Collection": "products",
        "ConnectTimeout": "00:00:10",
        "OperationTimeout": "00:00:05"
      }
    },
    "Cache": {
      "Enabled": true,
      "DefaultTtl": "00:00:30",
      "StaleTtl": "00:01:00",
      "Redis": {
        "Host": "redis",
        "Port": 6379,
        "Password": "",
        "Database": 0
      }
    },
    "WriteBehind": {
      "Enabled": true,
      "BatchSize": 50,
      "FlushInterval": "00:00:01",
      "StreamName": "products_write_queue"
    },
    "Metrics": {
      "Enabled": true,
      "Port": 8083,
      "Path": "/metrics"
    }
  }
}
